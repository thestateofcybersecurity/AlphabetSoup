# Connection strings. The app connects as outpost_app and can never bypass RLS.
OUTPOST_APP_DSN=postgresql://outpost_app@localhost:5432/outpost
OUTPOST_PROVISIONER_DSN=postgresql://outpost_provisioner@localhost:5432/outpost
# Superuser, used only by `outpost migrate` for the bootstrap migration. Unset in production.
OUTPOST_ADMIN_DSN=postgresql://postgres@localhost:5432/outpost
# Dev token signing. Production uses an asymmetric key in KMS; see src/outpost/auth.py.
OUTPOST_JWT_SECRET=change-me-dev-only-at-least-32-bytes-long-please
OUTPOST_ENV=dev
