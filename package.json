{
  "name": "alphabet-soup",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/generate-pages.ts && tsx scripts/og-images.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:analytics": "playwright test --config=playwright.production.config.ts",
    "shots": "vite preview --port 4188 --strictPort & sleep 3 && OUT=./shots BASE=http://localhost:4188 node scripts/shots.mjs; kill %1",
    "og:images": "tsx scripts/og-images.ts"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "satori": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
